<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ערכת הנושא הראשית של האפליקציה -->
    <style name="Base.Theme.Library" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lib_primary</item>
        <item name="colorOnPrimary">@color/lib_on_primary</item>
        <item name="colorPrimaryContainer">@color/lib_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/lib_primary</item>
        <item name="colorSecondary">@color/lib_accent</item>
        <item name="colorOnSecondary">@color/lib_on_accent</item>
        <item name="colorSecondaryContainer">@color/lib_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/lib_text</item>
        <item name="colorError">@color/lib_danger</item>

        <item name="android:colorBackground">@color/lib_bg</item>
        <item name="colorSurface">@color/lib_surface</item>
        <item name="colorOnSurface">@color/lib_text</item>
        <item name="colorSurfaceVariant">@color/lib_surface_alt</item>
        <item name="colorOnSurfaceVariant">@color/lib_text_muted</item>
        <item name="colorOutline">@color/lib_outline</item>
        <item name="colorOutlineVariant">@color/lib_outline</item>

        <item name="android:windowBackground">@color/lib_bg</item>
        <item name="android:statusBarColor">@color/lib_bg</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- סגנונות ברירת מחדל לרכיבים -->
        <item name="materialButtonStyle">@style/Widget.Library.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Library.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.Library.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.Library.Card</item>
    </style>

    <style name="Theme.Library" parent="Base.Theme.Library" />

    <!-- ===== כפתורים ===== -->
    <style name="Widget.Library.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/lib_primary</item>
        <item name="android:textColor">@color/lib_on_primary</item>
        <item name="iconTint">@color/lib_on_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Library.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/lib_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/lib_primary</item>
        <item name="iconTint">@color/lib_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- כפתור משני רך (רקע בהיר) -->
    <style name="Widget.Library.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/lib_surface_alt</item>
        <item name="android:textColor">@color/lib_text</item>
        <item name="iconTint">@color/lib_primary</item>
        <item name="iconPadding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="Widget.Library.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ===== שדות קלט ===== -->
    <style name="Widget.Library.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/lib_surface_alt</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/lib_primary</item>
        <item name="android:textColorHint">@color/lib_text_muted</item>
        <item name="startIconTint">@color/lib_text_muted</item>
        <item name="endIconTint">@color/lib_text_muted</item>
    </style>

    <style name="Widget.Library.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/lib_surface_alt</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/lib_primary</item>
        <item name="android:textColorHint">@color/lib_text_muted</item>
        <item name="startIconTint">@color/lib_text_muted</item>
        <item name="endIconTint">@color/lib_text_muted</item>
    </style>

    <!-- ===== כרטיסים ===== -->
    <style name="Widget.Library.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/lib_surface</item>
        <item name="strokeColor">@color/lib_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ===== טקסט ===== -->
    <style name="TextAppearance.Library.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/lib_text</item>
    </style>

    <style name="TextAppearance.Library.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/lib_text</item>
    </style>

    <style name="TextAppearance.Library.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/lib_text</item>
    </style>

    <style name="TextAppearance.Library.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/lib_text_muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.Library.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/lib_text_muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- צורה עגולה לתמונת פרופיל -->
    <style name="ShapeAppearance.Library.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
