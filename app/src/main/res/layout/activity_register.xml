<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F"
    tools:context=".RegisterActivity">

    <!-- כותרת ראשית -->
    <TextView
        android:id="@+id/tvRegisterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="יצירת חשבון חדש"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כותרת משנה -->
    <TextView
        android:id="@+id/tvRegisterSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="הירשמי כדי להתחיל"
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvRegisterTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- שדה אימייל / שם משתמש -->
    <EditText
        android:id="@+id/etRegisterEmail"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:hint="אימייל (שם משתמש)"
        android:textColor="#FFFFFF"
        android:textColorHint="#78909C"
        android:backgroundTint="#3D5AFE"
        android:inputType="textEmailAddress"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@+id/tvRegisterSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- שדה סיסמה -->
    <EditText
        android:id="@+id/etRegisterPassword"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:hint="סיסמה (לפחות 6 תווים)"
        android:textColor="#FFFFFF"
        android:textColorHint="#78909C"
        android:backgroundTint="#3D5AFE"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/etRegisterEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כפתור הרשמה -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRegisterSubmit"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="הירשמי"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#3D5AFE"
        app:cornerRadius="14dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/etRegisterPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>