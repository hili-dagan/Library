<?xml version="1.0" encoding="utf-8"?>
<!-- מסך פרופיל: תמונה, אימייל וסטטיסטיקות -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lib_bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- אזור עליון -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הפרופיל שלי"
                android:textAppearance="@style/TextAppearance.Library.Title" />

            <!-- תמונת פרופיל + כפתור החלפה -->
            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_marginTop="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfileImage"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:contentDescription="תמונת פרופיל"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/placeholder_avatar"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Library.Circle"
                    app:strokeColor="@color/lib_surface"
                    app:strokeWidth="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeProfileImage"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="שינוי תמונת פרופיל"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    app:backgroundTint="@color/lib_accent"
                    app:cornerRadius="22dp"
                    app:icon="@drawable/ic_lib_camera"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/lib_on_accent"
                    app:strokeColor="@color/lib_surface"
                    app:strokeWidth="3dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:text="user@email.com"
                android:textColor="@color/lib_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_lib_mail"
                app:drawableTint="@color/lib_text_muted" />
        </LinearLayout>

        <!-- סטטיסטיקות -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:text="סטטיסטיקות קריאה"
                android:textAppearance="@style/TextAppearance.Library.Section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- סך הכל ספרים -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_soft_circle"
                            android:backgroundTint="@color/lib_primary_soft"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_lib_library"
                            app:tint="@color/lib_primary" />

                        <TextView
                            android:id="@+id/tvTotalBooks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="serif"
                            android:text="0"
                            android:textColor="@color/lib_text"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ספרים בספרייה"
                            android:textAppearance="@style/TextAppearance.Library.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ספרים שנקראו -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_soft_circle"
                            android:backgroundTint="@color/lib_accent_soft"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_lib_check_circle"
                            app:tint="@color/lib_accent" />

                        <TextView
                            android:id="@+id/tvFinishedBooks"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="serif"
                            android:text="0"
                            android:textColor="@color/lib_text"
                            android:textSize="34sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ספרים שנקראו"
                            android:textAppearance="@style/TextAppearance.Library.Label" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- שמירת תמונת פרופיל -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="שמירת תמונת הפרופיל"
                app:icon="@drawable/ic_lib_check"
                app:iconGravity="textStart" />

            <!-- התנתקות -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.Library.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="התנתקות"
                android:textColor="@color/lib_danger"
                app:icon="@drawable/ic_lib_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/lib_danger"
                app:rippleColor="@color/lib_danger_soft" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
