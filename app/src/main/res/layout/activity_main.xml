<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A192F"
    tools:context=".MainActivity">

    <!-- לוגו או אייקון עליון (מוסיף המון מקצועיות) -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_menu_compass"
        app:tint="#3D5AFE"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvWelcome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- כותרת ראשית -->
    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שלום אורח"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@+id/ivLogo"
        app:layout_constraintBottom_toTopOf="@+id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כותרת משנה -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בחר אפשרות להמשך"
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        android:layout_marginBottom="36dp"
        app:layout_constraintTop_toBottomOf="@+id/tvWelcome"
        app:layout_constraintBottom_toTopOf="@+id/btnNewUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כפתור ראשי למשתמש חדש (מודגש בעיצוב מלא) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNewUser"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="יצירת חשבון חדש"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#3D5AFE"
        app:cornerRadius="14dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
        app:layout_constraintBottom_toTopOf="@+id/btnExistingUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כפתור משני למשתמש קיים (עיצוב Outlined מסגרת נקה) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnExistingUser"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="התחברות לחשבון קיים"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:strokeColor="#3D5AFE"
        app:strokeWidth="2dp"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@+id/btnNewUser"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>