<?xml version="1.0" encoding="utf-8"?>
<!-- מסך התחברות -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lib_bg"
    android:fillViewport="true"
    android:layoutDirection="rtl"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <!-- לוגו -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_logo_tile"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/ic_lib_book"
            app:tint="@color/lib_on_primary" />

        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="התחברות"
            android:textAppearance="@style/TextAppearance.Library.Display" />

        <TextView
            android:id="@+id/tvLoginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="טוב לראות אותך שוב. נמשיך מאיפה שהפסקת."
            android:textAppearance="@style/TextAppearance.Library.Body" />

        <!-- שדה אימייל -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:hint="אימייל"
            app:startIconDrawable="@drawable/ic_lib_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/lib_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- שדה סיסמה -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="סיסמה"
            app:endIconMode="password_toggle"
            app:startIconDrawable="@drawable/ic_lib_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/lib_text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- כפתור התחברות -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginSubmit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="התחברות" />

    </LinearLayout>
</ScrollView>
